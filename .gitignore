# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
# 빌드 산출물(sdist/wheel — CI 에서 생성, 커밋 금지)
dist/
build/

# SAGE 로컬 런타임 캐시(활성 우회 권한 등) — 머신 전용이라 커밋 금지.
# 감사 로그(.sage/override.jsonl)는 우회 이력을 추적·공유하려고 일부러 커밋한다.
.sage/tmp/

# PDCA 작업 문서는 로컬 실행 증거로 유지하고 00 base plan만 Git에서 공유한다.
plan_docs/01-plan/
plan_docs/02-design/
plan_docs/03-implementation/
plan_docs/04-analyze/
plan_docs/05-expert-review/
plan_docs/06-report/

# editor / OS
.DS_Store
*.swp

# prior bkit/claude local state (not part of SAGE)
.bkit/
# 저장소 루트의 .claude/ 전체 무시 — 엔진 저장소는 설치 산출물을 보유하지 않는다
# (아래 .codex/ 와 같은 원칙). 개별 경로만 나열하면 새 산출물(logs/·*.bak 등)이
# 매번 추적 후보로 새어 나온다.
# `/` 앵커 필수: 앵커가 없으면 모든 깊이에 매칭돼
# templates/core/framework/.claude/ 의 프레임워크 렌더가 추적 대상에서 빠진다.
/.claude/
# generated runtime artifacts (sage generate --write at repo root) — 프레임워크 repo 는 산출물 비보유
.codex/
.mcp.json

# CodeGraph 로컬 인덱스 (머신별, 커밋 제외)
.codegraph/
